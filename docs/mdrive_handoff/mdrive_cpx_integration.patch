@@ -0,0 +1,82 @@
+"""Focused tests for MDrive's exact-GT and multi-CAV CP-X data contract."""
+
+from types import SimpleNamespace
+import unittest
+
+import carla
+import numpy as np
+
+from team_code.cpx_planner_adapter import MDriveCAVRegistry, MDriveCPXPlanner
+from team_code.rule_planner import Detection
+
+
+class CAVRegistryTest(unittest.TestCase):
+    def test_messages_become_visible_only_after_tick_commit(self):
+        registry = MDriveCAVRegistry()
+        actor_a = SimpleNamespace(id=11)
+        actor_b = SimpleNamespace(id=22)
+        manager_a = SimpleNamespace(
+            v2x_manager=SimpleNamespace(cav_nearby={}, cav_intents={})
+        )
+        manager_b = SimpleNamespace(
+            v2x_manager=SimpleNamespace(cav_nearby={}, cav_intents={})
+        )
+        registry.register(actor_a, manager_a)
+        registry.register(actor_b, manager_b)
+
+        registry.begin_tick(1.0)
+        registry.stage_message(22, {"behavior": "yield"})
+        self.assertEqual(registry.peer_messages(11), {})
+
+        registry.commit_tick()
+        registry.begin_tick(1.05)
+        self.assertEqual(
+            registry.peer_messages(11)["22"]["behavior"], "yield"
+        )
+        self.assertIs(manager_a.v2x_manager.cav_nearby["22"], manager_b)
+
+
+class ExactGTStateTest(unittest.TestCase):
+    def test_exact_actor_state_bypasses_nearest_neighbor_tracking(self):
+        planner = MDriveCPXPlanner.__new__(MDriveCPXPlanner)
+        planner._detections = [Detection(
+            xy_ego=np.asarray([99.0, 99.0]),
+            radius=2.0,
+            score=1.0,
+            actor_id=22,
+            actor_type="vehicle.tesla.model3",
+            role_name="hero_1",
+            world_xy=np.asarray([10.0, 20.0]),
+            velocity_world=np.asarray([3.0, 4.0]),
+            acceleration_world=np.asarray([0.1, 0.2]),
+            angular_velocity_world=np.asarray([0.0, 0.0, 1.5]),
+            yaw=0.25,
+            length_m=4.7,
+            width_m=1.9,
+            is_controlled_ego=True,
+        )]
+        planner._last_track_time_s = None
+        planner._tracks = {}
+        planner._next_track_id = 1
+        planner._cav_registry = None
+
+        snapshots = planner._detection_snapshots(
+            transform=carla.Transform(), timestamp_s=1.05
+        )
+        self.assertEqual(len(snapshots), 1)
+        snapshot = snapshots[0]
+        self.assertEqual(snapshot["carla_actor_id"], 22)
+        self.assertEqual((snapshot["x"], snapshot["y"]), (10.0, 20.0))
+        self.assertEqual(snapshot["v"], 5.0)
+        self.assertEqual(snapshot["psi"], 0.25)
+        self.assertEqual(snapshot["length_m"], 4.7)
+        self.assertEqual(snapshot["width_m"], 1.9)
+        self.assertEqual(snapshot["angular_velocity"], [0.0, 0.0, 1.5])
+
+    def test_legacy_detection_constructor_stays_compatible(self):
+        detection = Detection(np.asarray([1.0, 2.0]), 2.0, 0.9)
+        self.assertIsNone(detection.actor_id)
+
+
+if __name__ == "__main__":
+    unittest.main()
