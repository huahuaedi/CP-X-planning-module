diff --git a/simulation/leaderboard/team_code/agent_config/cpx_gt.yaml b/simulation/leaderboard/team_code/agent_config/cpx_gt.yaml
new file mode 100644
index 00000000..54a804b2
--- /dev/null
+++ b/simulation/leaderboard/team_code/agent_config/cpx_gt.yaml
@@ -0,0 +1,145 @@
+# CP-X planning with CARLA ground-truth actor perception.
+# No HEAL/AttFuse model or checkpoint is loaded in this mode.
+detector: gt
+planner: cpx
+use_gt_perception: true
+log_tag: cpx_gt
+
+# Ground-truth actors are range-gated in each ego's local frame.
+gt_lidar_range: [-102.4, -102.4, -3.0, 102.4, 102.4, 1.0]
+# Merge/share each controlled CAV's local 360deg/100m GT box across the
+# fleet (union of ranges), since there's no detector in this mode to do
+# cooperative fusion the normal way.
+cooperative: true
+collect_ap_metrics: false
+disable_brake: false
+detection_radius: 1.5
+cruise_speed: 11.18
+target_speed_kmh: 40.2
+
+cpx:
+  # All egos CPX-controlled and cooperative for multi-CAV testing on
+  # scenarios that already pass single-ego (999 clamps to however many
+  # egos the route actually spawns).
+  controlled_ego_count: 999
+  # Re-plan the leaderboard-supplied route through our own GlobalRoutePlanner
+  # (route_manager.replan_from) instead of just consuming the leaderboard's
+  # pre-traced path as-is -- exercises our own routing/search code for the
+  # everyday case, not just the (normally disabled) obstacle-reroute path.
+  use_own_global_planner: true
+  secondary_planner: basicagent
+  mode: full_cpx_mpc
+  fallback_policy: emergency_stop
+  target_speed_mps: 11.18
+  max_mpc_obstacles: 8
+  tracker_max_stale_s: 0.5
+  prediction_min_ttc_s: 2.0
+  full_candidate_pipeline_enabled: true
+  full_candidate_reference_min_object_distance_m: 3.5
+  static_obstacle_local_avoidance_min_object_distance_m: 0.8
+  full_allow_opportunistic_lane_change: true
+  full_dense_traffic_lane_change_lock_enabled: true
+  full_traffic_hold_stop_unknown_until_green: false
+  full_stop_hold_speed_mps: 0.10
+  full_stop_hold_brake: 0.60
+  control_buffer_enabled: false
+  control_buffer_max_reuse_s: 0.35
+  full_control_buffer_min_speed_mps: 1.5
+  full_low_speed_straight_steer_guard_enabled: true
+  full_low_speed_straight_steer_guard_max_speed_mps: 3.5
+  full_intersection_turn_speed_cap_mps: 1.2
+  scenario_turn_prepare_speed_cap_mps: 1.6
+  safety_supervisor_enabled: true
+  record_evaluation_metrics: false
+  record_collision_sensor: false
+
+  # Off by default upstream, and left off here for every earlier run in
+  # this test pass -- confirmed via cav_arbitration/cav_conflict_tags
+  # staying empty ({}) on every tick, including through an actual
+  # collision in Intersection_Deadlock_Resolution/3 (a left-turning ego
+  # crossed a straight-through ego's path with no yield/crossing
+  # arbitration at all). This is the only switch that turns on
+  # classify_conflicts' CROSSING/ONCOMING detection and the Stage-D
+  # corridor that encodes its yield decision as an MPC constraint; see
+  # cpx_mpc_planner.py's _load_mpc_config, which now also flips mpc.yaml's
+  # cost.corridor.enabled to match (that second half was previously never
+  # wired to this flag at all, so setting only this would have been a
+  # silent no-op).
+  cav_conflict_enabled: true
+
+  # The linear throttle feedforward (accel/max_accel + cruise_feedforward)
+  # settles into a false equilibrium well below target_speed_mps once
+  # aerodynamic drag at that speed exactly cancels the feedforward's fixed
+  # throttle guess -- confirmed via telemetry: throttle plateaus at ~0.49,
+  # measured accel nets to ~0, actual speed sticks at ~9.87 m/s even
+  # though target_speed_mps is 11.18 and commanded accel stays positive.
+  # This closed-loop term was previously disabled (gain 0.0), so nothing
+  # ever pushed extra throttle in to correct that persistent error. Raise
+  # the ceiling alongside it so the added boost isn't immediately clipped
+  # back down by cruise_max_throttle. gain=0.15 confirmed the mechanism
+  # (raised the plateau from ~9.87 to ~10.3 m/s) but a proportional-only
+  # term always leaves residual steady-state error at its new equilibrium
+  # too -- telemetry with Interactive_Lane_Change's two CAVs converged to
+  # a common cruise speed still showed actual speed stuck at ~10.3 m/s
+  # while IDM kept commanding +0.56 m/s^2 the whole time (never
+  # satisfied), applied_throttle frozen flat at ~0.505, and measured
+  # accel ~0 despite a steady positive accel_cmd -- the same false-
+  # equilibrium signature, just at a higher speed. Raising the gain
+  # further pushes that equilibrium closer to the 11.18 target.
+  actuator_speed_error_throttle_gain: 0.25
+  actuator_cruise_max_throttle: 0.75
+  # An integral term (actuator_mapper.py's _integrate_speed_error) exists
+  # to close the proportional term's residual steady-state error.
+  # gain=0.05 against IDM's constantly-recomputed (not fixed) target
+  # produced a sustained ~10.4<->11.3 m/s oscillation -- confirmed via
+  # telemetry: ego_0 hunted with a ~2-2.5s period and the Interactive_
+  # Lane_Change gap grew from ~28m to ~42m and kept climbing, worse than
+  # with the integral term off. Retrying at 1/5th the gain so it still
+  # closes the residual error but accumulates -- and therefore corrects
+  # -- much more slowly relative to IDM's own retargeting rate.
+  actuator_speed_error_integral_gain: 0.01
+  actuator_max_speed_error_integral_boost: 0.15
+
+  # IDM (speed_planner.py's build_speed_plan) recomputes its reachable
+  # target every tick as ego_speed_mps + idm_acceleration*horizon_s, using
+  # the vehicle's actual measured speed as the base each time rather than
+  # an integrated running target. With the 0.20s default horizon, even a
+  # near-max IDM acceleration command (~1.95 m/s^2, confirmed via
+  # telemetry after Interactive_Lane_Change's lane change completes) only
+  # asks for +0.39 m/s above wherever the car already is -- so the target
+  # is always "barely ahead of right now" and the car never builds real
+  # cumulative acceleration back toward cruise (measured: <1 m/s gained
+  # over 22s despite IDM pegged near its ceiling the whole time). Widening
+  # the horizon gives the same single IDM controller a real target to
+  # chase instead of one that moves at nearly the same rate as the car.
+  #
+  # 1.0s fixed the "stuck below cruise" case, but once both CAVs converge
+  # near a shared plateau, IDM settles on a small residual accel (~0.56
+  # m/s^2 with a ~9-10m gap over its own desired spacing) and the target
+  # (ego_speed + accel*horizon) still only asks for ~0.5-0.6 m/s above
+  # current speed -- nowhere near the following_max_catchup_delta_mps
+  # headroom (2.0 m/s above nominal cruise) already available for closing
+  # a gap. Raising the actuator's proportional gain instead (0.15->0.25)
+  # barely moved the gap (30.4m->29.7m) because it lifts both CAVs'
+  # plateau equally, leaving their relative speeds -- and therefore the
+  # gap -- unchanged. Widening the horizon further lets the same IDM
+  # acceleration reach further into that unused catch-up headroom.
+  following_idm_target_horizon_s: 2.0
+
+  # IDM's own desired following spacing is standstill_gap_m + speed_mps *
+  # time_headway_s. At the default time_headway_s=1.5s and ~11 m/s
+  # cruise, that is ~21.7m -- IDM will actively brake to keep the gap
+  # near that value, so no following-cap/horizon/actuator tuning above
+  # can ever settle the gap near the ~10m the user wants without also
+  # shrinking IDM's own idea of "close enough". time_headway_s=0.6
+  # (confirmed via telemetry: converged to ~20m, no oscillation, with the
+  # trailing CAV visibly exceeding the leader's speed briefly to close
+  # in before matching it) was a good, safe intermediate step -- but a
+  # steady 3m gap was also asked about. Rejected: 3m sits exactly on top
+  # of following_emergency_gap_m's 3.0m hard stop-or-brake floor, so
+  # IDM's own comfort target and the emergency threshold would
+  # constantly fight, likely flapping between normal follow and
+  # emergency braking rather than holding a stable gap. 0.2 keeps a
+  # real margin above that floor (~5 + 11*0.2 = ~7.2m at cruise) while
+  # still much tighter than the 0.6 step.
+  following_time_headway_s: 0.2
diff --git a/simulation/leaderboard/team_code/agent_config/cpx_gt_primary_only.yaml b/simulation/leaderboard/team_code/agent_config/cpx_gt_primary_only.yaml
