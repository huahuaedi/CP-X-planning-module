+class _MDrivePlannerHud:
+    """Planning HUD that consumes existing MDrive camera frames only."""
+
+    def __init__(self) -> None:
+        import cv2
+
+        self.cv2 = cv2
+        self.width = 640
+        self.height = 360
+        self.hud_height = 250
+        self.window_name = "MDrive + CP-X PRIMARY EGO - Topdown | Chase"
+        cv2.namedWindow(self.window_name, cv2.WINDOW_NORMAL)
+        cv2.resizeWindow(
+            self.window_name, self.width * 2, self.height + self.hud_height
+        )
+        self.enabled = True
+
+    def _frame(self, image):
+        if image is None or not hasattr(image, "shape"):
+            return None
+        array = np.asarray(image)
+        if array.ndim != 3 or array.shape[2] < 3:
+            return None
+        return self.cv2.resize(
+            np.ascontiguousarray(array[:, :, :3]),
+            (self.width, self.height),
+            interpolation=self.cv2.INTER_AREA,
+        )
+
+    def _project(self, point, actor):
+        if point is None or len(point) < 2:
+            return None
+        try:
+            point_x = float(point[0])
+            point_y = float(point[1])
+        except (TypeError, ValueError):
+            return None
+        transform = actor.get_transform()
+        yaw = math.radians(float(transform.rotation.yaw))
+        dx = point_x - float(transform.location.x)
+        dy = point_y - float(transform.location.y)
+        forward = dx * math.cos(yaw) + dy * math.sin(yaw)
+        right = dx * math.sin(yaw) - dy * math.cos(yaw)
+        px = int(round(0.5 * self.width + right * self.width / 120.0))
+        py = int(round(0.5 * self.height - forward * self.height / 120.0))
+        if 0 <= px < self.width and 0 <= py < self.height:
+            return px, py
+        return None
+
+    def _draw_path(self, canvas, points, actor, color, width=2) -> None:
+        projected = [
+            self._project(point, actor)
+            for point in list(points or [])
+            if hasattr(point, "__len__") and len(point) >= 2
+        ]
+        projected = [point for point in projected if point is not None]
+        if len(projected) >= 2:
+            self.cv2.polylines(
+                canvas,
+                [np.asarray(projected, dtype=np.int32)],
+                False,
+                color,
+                width,
+                lineType=self.cv2.LINE_AA,
+            )
+
+    def render(self, *, top_image, front_image, actor, debug) -> None:
+        if not self.enabled:
+            return
+        canvas = np.full(
+            (self.height + self.hud_height, self.width * 2, 3),
+            18,
+            dtype=np.uint8,
+        )
+        top_frame = self._frame(top_image)
+        front_frame = self._frame(front_image)
+        if top_frame is not None:
+            canvas[: self.height, : self.width] = top_frame
+        if front_frame is not None:
+            canvas[: self.height, self.width :] = front_frame
+        self._draw_path(
+            canvas, debug.get("global_route_points", []), actor, (60, 205, 235), 2
+        )
+        self._draw_path(
+            canvas, debug.get("mpc_trajectory_points", []), actor, (85, 220, 45), 3
+        )
+        destination = self._project(
+            [debug.get("destination_x"), debug.get("destination_y")], actor
+        )
+        if destination is not None:
+            self.cv2.circle(
+                canvas, destination, 6, (245, 145, 45), -1, lineType=self.cv2.LINE_AA
+            )
+
+        panel_y = self.height
+        velocity = actor.get_velocity()
+        speed = math.sqrt(velocity.x ** 2 + velocity.y ** 2 + velocity.z ** 2)
+        lines = [
+            "CP-X PRIMARY EGO | MDrive scenario | CARLA GT perception",
+            f"vehicle={actor.id} speed={speed:.2f} m/s behavior={debug.get('behavior_decision', '')} fsm={debug.get('behavior_fsm_state', '')}",
+            f"scenario={debug.get('scenario_fsm_state', '')} traffic={debug.get('traffic_signal_state', '')} stop={debug.get('stop_goal_active', '')}",
+            f"candidate={debug.get('candidate_pipeline_selected', '')} status={debug.get('candidate_pipeline_selected_status', '')}",
+            f"reference={debug.get('reference_source', '')} stage={debug.get('reference_pipeline_stage', '')}",
+            f"MPC={debug.get('mpc_status', '')} solve={debug.get('mpc_solve_time_ms', '')} ms fallback={debug.get('mpc_fallback_reason', '')}",
+            f"control={debug.get('decision_final_action', '')} source={debug.get('decision_control_source', '')} veto={debug.get('decision_veto_count', '')}",
+            f"route_remaining={debug.get('route_remaining_distance_m', '')} m objects={debug.get('object_count', '')} predictions={debug.get('candidate_prediction_trajectory_count', '')}",
+        ]
+        for index, line in enumerate(lines):
+            column = index // 4
+            row = index % 4
+            self.cv2.putText(
+                canvas,
+                str(line),
+                (12 + column * self.width, panel_y + 28 + row * 42),
+                self.cv2.FONT_HERSHEY_SIMPLEX,
+                0.43,
+                (235, 235, 235),
+                1,
+                lineType=self.cv2.LINE_AA,
+            )
+        self.cv2.imshow(self.window_name, canvas)
+        key = int(self.cv2.waitKey(1)) & 0xFF
+        if key in (27, ord("q")):
+            self.enabled = False
+
+    def destroy(self) -> None:
+        self.enabled = False
+        try:
+            self.cv2.destroyWindow(self.window_name)
+        except Exception:
+            pass
+
