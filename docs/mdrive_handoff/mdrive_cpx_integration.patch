+"""MDrive adapter for the CP-X behavior/reference/MPC planning pipeline."""
+
+from __future__ import annotations
+
+import math
+import os
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+from typing import Any, Dict, List, Mapping, Optional, Sequence
+
+import carla
+import numpy as np
+
+from team_code.rule_planner import Detection
+
+
+def _planning_repo_root() -> Path:
+    configured = str(os.environ.get("CPX_PLANNING_REPO", "") or "").strip()
+    if configured:
+        candidate = Path(configured).expanduser().resolve()
+    else:
+        mdrive_root = Path(__file__).resolve().parents[3]
+        candidate = mdrive_root.parent / "Planning module"
+    if not (candidate / "opencda" / "planning_module").is_dir():
+        raise RuntimeError(
+            "CP-X planning repository not found. Set CPX_PLANNING_REPO to the "
+            "directory containing opencda/planning_module; resolved "
+            f"{candidate}"
+        )
+    return candidate
+
+
+def _preload_newer_libstdcxx() -> None:
+    """dlopen a newer libstdc++ into this process only, not its children.
+
+    convert_to_ros's AD-map global planner links libad_physics.so, which
+    needs GLIBCXX_3.4.29+; tcp_codriving_clean's own libstdc++ only goes to
+    3.4.28. The previous fix for this was an LD_PRELOAD environment
+    variable set by the launching shell script -- but LD_PRELOAD is
+    inherited by every child process, including the CarlaUE4 game server
+    that run_custom_eval.py's --start-carla spawns from this same process
+    tree. Forcing a foreign libstdc++ into the Unreal Engine binary that
+    way made CARLA itself fail to start (confirmed: CARLA opened its RPC
+    port in 20s launched standalone with a clean environment, then failed
+    to open it within run_custom_eval.py's 180s timeout three times in a
+    row with LD_PRELOAD set, on ports that worked standalone). A same-
+    process ctypes.CDLL(..., RTLD_GLOBAL) call, done here right before the
+    only import that needs it, resolves the same symbol requirement for
+    this Python process's own dynamic linker without setting anything in
+    the environment a spawned child could inherit.
+    """
+
+    import ctypes
+
+    for candidate in (
+        "/usr/lib/x86_64-linux-gnu/libstdc++.so.6",
+        "libstdc++.so.6",
+    ):
+        try:
+            ctypes.CDLL(candidate, mode=ctypes.RTLD_GLOBAL)
+            return
+        except OSError:
+            continue
+
+
+def _load_bridge_class():
+    repo_root = _planning_repo_root()
+    planning_root = repo_root / "opencda" / "planning_module"
+    for path in (str(repo_root), str(planning_root)):
+        if path not in sys.path:
+            sys.path.insert(0, path)
+    _preload_newer_libstdcxx()
+    from opencda.planning_module.opencda_bridge.cpx_mpc_planner import (
+        CPXMPCPlannerBridge,
+    )
+
+    return CPXMPCPlannerBridge
+
