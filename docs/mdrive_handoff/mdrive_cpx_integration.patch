+def _default_opencda_pid_controller_args(dt_s: float) -> Dict[str, object]:
+    """OpenCDA's stock PID gains (opencda/scenario_testing/config_yaml/
+    default.yaml's ``controller.args``).
+
+    The convert_to_ros CP-X branch moved actuation off of its own
+    ``CarlaActuatorMapper`` and onto ``OpenCDAVelocitySteeringAdapter``, which
+    hard-requires a real OpenCDA ``Controller`` (``lon_run_step()``) and
+    raises at construction time if none is supplied. MDrive only supplies the
+    scenario/perception/route; the CP-X pipeline owns planning *and*
+    actuation end-to-end on this branch, so this is a genuine OpenCDA
+    controller instance -- not a re-tuned stand-in -- using the same defaults
+    OpenCDA scenarios ship with. Only the longitudinal (``lon``) gains and
+    ``max_brake``/``max_throttle`` are exercised: MPC still supplies steering
+    directly, so the lateral PID here is constructed but never stepped.
+    """
+    return {
+        "lat": {"k_p": 0.75, "k_d": 0.02, "k_i": 0.4},
+        "lon": {"k_p": 0.37, "k_d": 0.024, "k_i": 0.032},
+        "dynamic": False,
+        "dt": float(dt_s),
+        "max_brake": 1.0,
+        "max_throttle": 1.0,
+        "max_steering": 0.3,
+    }
+
+
+class _MDriveVehicleManager:
+    """Minimum OpenCDA runtime surface consumed by CPXMPCPlannerBridge."""
+
+    def __init__(self, actor: carla.Vehicle):
+        self.vehicle = actor
+        self.carla_map = actor.get_world().get_map()
+        self.localizer = _ActorLocalizer(actor)
+        self.perception_manager = SimpleNamespace(
+            objects={"vehicles": [], "traffic_lights": []}
+        )
+        self.v2x_manager = SimpleNamespace(cav_nearby={}, cav_intents={})
+        self.safety_manager = None
+        self.map_manager = None
+        self.agent = None
+        from opencda.core.actuation.pid_controller import Controller
+
+        dt_s = actor.get_world().get_settings().fixed_delta_seconds or 0.05
+        self.controller = Controller(_default_opencda_pid_controller_args(dt_s))
+
+
+class MDriveCAVRegistry:
+    """Tick-consistent registry shared by all CP-X egos in one agent.
+
+    Planners read only the last committed tick. New messages are staged while
+    the per-ego loop runs and become visible together at ``commit_tick``. This
+    prevents ego ordering from changing who can observe a fresh intent.
+    """
+
+    def __init__(self) -> None:
+        self._members: Dict[int, _MDriveVehicleManager] = {}
+        self._committed: Dict[int, Dict[str, object]] = {}
+        self._read_snapshot: Dict[int, Dict[str, object]] = {}
+        self._staged: Dict[int, Dict[str, object]] = {}
+        self._tick_time_s: Optional[float] = None
+
+    def register(self, actor: carla.Vehicle, manager: _MDriveVehicleManager) -> None:
+        self._members[int(actor.id)] = manager
+
+    def begin_tick(self, timestamp_s: float) -> None:
+        self._tick_time_s = float(timestamp_s)
+        self._read_snapshot = {
+            int(actor_id): dict(message)
+            for actor_id, message in self._committed.items()
+        }
+        self._staged = {}
+        for actor_id, manager in self._members.items():
+            manager.v2x_manager.cav_nearby = {
+                str(peer_id): peer_manager
+                for peer_id, peer_manager in self._members.items()
+                if int(peer_id) != int(actor_id)
+            }
+            manager.v2x_manager.cav_intents = self.peer_messages(actor_id)
+
+    def peer_messages(self, actor_id: int) -> Dict[str, Dict[str, object]]:
+        return {
+            str(peer_id): dict(message)
+            for peer_id, message in self._read_snapshot.items()
+            if int(peer_id) != int(actor_id)
+        }
+
+    def stage_message(self, actor_id: int, message: Mapping[str, object]) -> None:
+        payload = dict(message)
+        payload["actor_id"] = int(actor_id)
+        if self._tick_time_s is not None:
+            payload["timestamp_s"] = float(self._tick_time_s)
+        self._staged[int(actor_id)] = payload
+
+    def commit_tick(self) -> None:
+        self._committed = {
+            int(actor_id): dict(message)
+            for actor_id, message in self._staged.items()
+        }
+
+    @property
+    def committed_messages(self) -> Dict[int, Dict[str, object]]:
+        return {
+            int(actor_id): dict(message)
+            for actor_id, message in self._committed.items()
+        }
+
+
+class MDriveSecondaryIntentPublisher:
+    """Broadcast a non-CP-X (secondary-planner) ego's own plan as a CavIntent.
+
+    Registers into MDriveCAVRegistry exactly like a real MDriveCPXPlanner's
+    vehicle manager, so a CP-X ego's ``_collect_cav_intents()`` can read this
+    car's actual trajectory via ``peer.cpx_planner.last_cav_intent_payload``
+    -- but this never runs MPC or any candidate/corridor pipeline itself.
+    The underlying planner (BasicAgentPlanner/BehaviorAgentPlanner) always
+    just executes its own plan unmodified; only the CP-X ego(s) read these
+    intents and react. Negotiation is one-directional by design: these cars
+    have no concept of yielding to a broadcast intent, which is exactly what
+    ``cooperative=False`` on the CavIntent means (see its docstring in
+    cooperative_arbitration.py) -- the CP-X side's conflict classification
+    still sees this car's position/trajectory, but Stage B's role assignment
+    (yield/make_gap) is never applied to it.
+    """
+
+    def __init__(
+        self,
+        *,
+        actor: carla.Vehicle,
+        planner: Any,
+        cav_registry: Optional["MDriveCAVRegistry"],
+        ego_index: Optional[int] = None,
+    ) -> None:
+        self._actor = actor
+        self._planner = planner
+        self._cav_registry = cav_registry
+        self._ego_index = ego_index
+        self.v2x_manager = SimpleNamespace(cav_nearby={}, cav_intents={})
+        self.cpx_planner = self
+        self.last_cav_intent_payload: Optional[Dict[str, object]] = None
+        self._sequence = 0
+        if cav_registry is not None:
+            cav_registry.register(actor, self)
+
+    def publish_intent(self, *, sim_time_s: float) -> None:
+        del sim_time_s  # see world_time_s below for why this is unused
+        if self._cav_registry is None:
+            return
+        from opencda.planning_module.pipeline.cav_intent_codec import (
+            build_ego_cav_intent,
+            cav_intent_to_payload,
+        )
+        from opencda.planning_module.pipeline.cooperative_arbitration import (
+            ResourceClaim,
+        )
+
+        # CPXMPCPlannerBridge._collect_cav_intents() checks freshness against
+        # its own bridge._sim_time_s() (raw carla.WorldSnapshot.timestamp.
+        # elapsed_seconds), not against whatever clock the caller passes to
+        # run_step()/publish_intent(). The leaderboard's own `timestamp`
+        # argument (what perception_swap_agent.py's tick loop passes as
+        # sim_time_s) is a *different* clock -- roughly zeroed per route --
+        # so stamping generated_at_s with it made every payload's
+        # valid_until_s fall far behind the bridge's elapsed_seconds-based
+        # now_s, and cav_transport showed accepted_count=0/rejected.expired
+        # equal to nearby_count on every tick (confirmed via debug jsonl).
+        # Match the bridge's own clock instead.
+        world_time_s = float(
+            self._actor.get_world().get_snapshot().timestamp.elapsed_seconds
+        )
+
+        transform = self._actor.get_transform()
+        velocity = self._actor.get_velocity()
+        speed_mps = math.sqrt(float(velocity.x) ** 2 + float(velocity.y) ** 2)
+        heading_rad = math.radians(float(transform.rotation.yaw))
+
+        try:
+            points = self._planner.predict_trajectory(horizon_s=3.0, dt=0.1)
+        except Exception:
+            points = None
+        planned_states: List[List[float]] = []
+        if points is not None and len(points) >= 2:
+            dt_s = 0.1
+            for idx in range(len(points)):
+                x_m, y_m = float(points[idx][0]), float(points[idx][1])
+                if idx + 1 < len(points):
+                    dx_m = float(points[idx + 1][0]) - x_m
+                    dy_m = float(points[idx + 1][1]) - y_m
+                    speed_sample_mps = min(45.0, math.hypot(dx_m, dy_m) / dt_s)
+                else:
+                    speed_sample_mps = (
+                        planned_states[-1][2] if planned_states else speed_mps
+                    )
+                planned_states.append([x_m, y_m, speed_sample_mps])
+
+        # No lane-change resource claim: these cars never negotiate for one,
+        # so this is always the "released" shape claim managers elsewhere in
+        # the pipeline already use for "not contending for anything".
+        claim = ResourceClaim(
+            kind="lane_change", resource_id="lane_change",
+            committed_at_s=world_time_s, active=False,
+            require_ahead=False, phase="released",
+        )
+        try:
+            extent = self._actor.bounding_box.extent
+            length_m = 2.0 * float(extent.x)
+            width_m = 2.0 * float(extent.y)
+        except Exception:
+            length_m = 0.0
+            width_m = 0.0
+
+        intent = build_ego_cav_intent(
+            actor_id=int(self._actor.id),
+            position_xy=(float(transform.location.x), float(transform.location.y)),
+            heading_rad=float(heading_rad),
+            speed_mps=float(speed_mps),
+            claim=claim,
+            planned_states=planned_states,
+            dt_s=0.1,
+            t0_s=0.0,
+            cooperative=False,
+            generated_at_s=world_time_s,
+            valid_for_s=0.5,
+            sequence=self._sequence,
+            length_m=length_m,
+            width_m=width_m,
+        )
+        self._sequence += 1
+        self.last_cav_intent_payload = cav_intent_to_payload(intent)
+
+
+class MDriveCPXPlanner:
+    """Use MDrive perception and route inputs with the complete CP-X pipeline."""
+
+    def __init__(
+        self,
+        *,
+        actor: carla.Vehicle,
+        target_speed_kmh: float,
+        config: Optional[Mapping[str, object]] = None,
+        debug_output_dir: Optional[str] = None,
+        cav_registry: Optional[MDriveCAVRegistry] = None,
+        ego_index: Optional[int] = None,
+    ) -> None:
+        if actor is None:
+            raise ValueError("MDriveCPXPlanner requires a spawned hero actor")
+        self._actor = actor
+        self._ego_index = ego_index
+        self._cav_registry = cav_registry
+        self._target_speed_mps = max(0.0, float(target_speed_kmh) / 3.6)
+        self._detections: List[Detection] = []
+        self._world_plan: List[Any] = []
+        self._traffic_lights: Optional[List[_TrafficLightView]] = None
+        self._tracks: Dict[int, Dict[str, float]] = {}
+        self._next_track_id = 1
+        self._last_track_time_s: Optional[float] = None
+        self._last_debug: Dict[str, object] = {}
+
+        output_dir = Path(
+            debug_output_dir
+            or os.environ.get("CPX_MDRIVE_DEBUG_DIR", "")
+            or "/tmp/cpx_mdrive_debug"
+        )
+        output_dir.mkdir(parents=True, exist_ok=True)
+        bridge_config = {
+            "enabled": True,
+            "mode": "full_cpx_mpc",
+            "fallback_policy": "emergency_stop",
+            # convert_to_ros dropped the plain-CARLA "legacy" global-planner
+            # mode entirely -- only its own AD-map/Dijkstra backend
+            # (opencda.planning_module.utility.global_planner_factory
+            # .CUSTOM_GLOBAL_PLANNER_MODES) remains, and "dij" is its
+            # default. The backend auto-resolves its .xodr from
+            # map_planner.name (our CARLA carla_map), so this works for any
+            # town with a bundled map under Global_Planner/maps/.
+            "global_planner_mode": "dij",
+            "use_opencda_global_route": True,
+            "opencda_global_route_reference_allowed": True,
+            "publish_cp_message": True,
+            "require_native_opencda_cp": True,
+            "target_speed_mps": float(self._target_speed_mps),
+            "full_allow_opportunistic_lane_change": False,
+            "record_debug": True,
+            "debug": bool(int(os.environ.get("CPX_MDRIVE_VERBOSE", "0"))),
+            "debug_output_dir": str(output_dir),
+            "cp_message_path": str(output_dir / "cp_message.json"),
+            "record_evaluation_metrics": False,
+            "record_collision_sensor": False,
+            "scenario_name": "mdrive_perception_swap",
+        }
+        bridge_config.update(dict(config or {}))
+        bridge_config["target_speed_mps"] = float(
+            bridge_config.get("target_speed_mps", self._target_speed_mps)
+        )
+        bridge_config["debug_output_dir"] = str(output_dir)
+        bridge_config["cp_message_path"] = str(output_dir / "cp_message.json")
+
+        bridge_class = _load_bridge_class()
+        self._vehicle_manager = _MDriveVehicleManager(actor)
+        if self._cav_registry is not None:
+            self._cav_registry.register(actor, self._vehicle_manager)
+        self._bridge = bridge_class(
+            self._vehicle_manager,
+            bridge_config,
+            map_planner=self._vehicle_manager.carla_map,
+        )
+        # CPXMPCPlannerBridge._collect_cav_intents() reads each nearby peer's
+        # intent off ``peer_vehicle_manager.cpx_planner.last_cav_intent_payload``
+        # (cpx_mpc_planner.py), not off the registry payload dict directly.
+        # Without this back-reference every peer lookup silently misses
+        # (``cpx_planner is None`` -> skipped), so cav_conflict_enabled's
+        # cooperative arbitration (Stage B/C/D corridor yield) would see zero
+        # peer intents even with multiple CP-X-controlled CAVs.
+        self._vehicle_manager.cpx_planner = self._bridge
+
+    def set_global_plan(self, world_plan: Sequence[Any]) -> None:
+        self._world_plan = list(world_plan or [])
+        if len(self._world_plan) < 2:
+            raise ValueError("MDriveCPXPlanner received a route shorter than two points")
+        self._bridge.set_external_global_plan(self._world_plan)
+
+    def set_detections(self, detections: Sequence[Detection]) -> None:
+        self._detections = list(detections or [])
+
+    def run_step(self, sim_time_s: Optional[float] = None) -> carla.VehicleControl:
+        if len(self._world_plan) < 2:
+            raise RuntimeError("MDriveCPXPlanner global plan has not been installed")
+        transform = self._actor.get_transform()
+        velocity = self._actor.get_velocity()
+        speed_mps = math.sqrt(
+            float(velocity.x) ** 2
+            + float(velocity.y) ** 2
+            + float(velocity.z) ** 2
+        )
+        timestamp_s = (
+            float(sim_time_s)
+            if sim_time_s is not None
+            else float(
+                self._actor.get_world().get_snapshot().timestamp.elapsed_seconds
+            )
+        )
+        snapshots = self._detection_snapshots(
+            transform=transform,
+            timestamp_s=float(timestamp_s),
+        )
+        perception_objects = {
+            "vehicles": snapshots,
+            "traffic_lights": self._traffic_light_views(),
+        }
+        self._vehicle_manager.perception_manager.objects = perception_objects
+        self._bridge.update_information(
+            ego_transform=transform,
+            ego_speed_kmh=float(speed_mps) * 3.6,
+            detected_objects=perception_objects,
+            v2x_manager=self._vehicle_manager.v2x_manager,
+            safety_manager=None,
+            map_manager=None,
+        )
+        control = self._bridge.run_step()
+        self._last_debug = dict(self._bridge.last_debug or {})
+        self._stage_cooperative_intent(timestamp_s=float(timestamp_s))
+        return control
+
+    def _stage_cooperative_intent(self, *, timestamp_s: float) -> None:
+        if self._cav_registry is None:
+            return
+        raw_points = list(self._last_debug.get("mpc_trajectory_points", []) or [])
+        trajectory = []
+        for point in raw_points:
+            try:
+                if len(point) >= 2:
+                    trajectory.append([float(point[0]), float(point[1])])
+            except Exception:
+                continue
+        if not trajectory:
+            trajectory = self.predict_trajectory(horizon_s=3.0, dt=0.1).tolist()
+        self._cav_registry.stage_message(int(self._actor.id), {
+            "ego_index": self._ego_index,
+            "behavior": str(self._last_debug.get("behavior_decision", "")),
+            "maneuver": str(
+                self._last_debug.get(
+                    "reference_pipeline_intent",
+                    self._last_debug.get("behavior_decision", ""),
+                )
+            ),
+            "target_speed_mps": float(
+                self._last_debug.get("target_speed_mps", self._target_speed_mps)
+                or self._target_speed_mps
+            ),
+            "predicted_trajectory": trajectory,
+            "planner_timestamp_s": float(timestamp_s),
+            # Lane-change commitment, broadcast as-is so peer CAVs can decide
+            # to yield (hold in lane) while this vehicle is mid-lane-change;
+            # see CPXMPCPlannerBridge._cooperative_lane_change_yield_reason.
+            "maneuver_commitment_active": bool(
+                self._last_debug.get("maneuver_commitment_active", False)
+            ),
+            "maneuver_commitment_decision": str(
+                self._last_debug.get("maneuver_commitment_decision", "")
+            ),
+            "maneuver_commitment_source_lane_id": self._last_debug.get(
+                "maneuver_commitment_source_lane_id", ""
+            ),
+            "maneuver_commitment_target_lane_id": self._last_debug.get(
+                "maneuver_commitment_target_lane_id", ""
+            ),
+            "maneuver_commitment_committed_at_s": float(
+                self._last_debug.get("maneuver_commitment_committed_at_s", 0.0)
+                or 0.0
+            ),
+            # Static-obstacle local-avoidance claim, broadcast for the same
+            # reason as the lane-change commitment above; see
+            # CPXMPCPlannerBridge._cooperative_avoidance_lane_yield_reason.
+            "static_obstacle_local_avoidance_active": bool(
+                self._last_debug.get("static_obstacle_local_avoidance_active", False)
+            ),
+            "static_obstacle_local_target_lane_id": self._last_debug.get(
+                "static_obstacle_local_target_lane_id", ""
+            ),
+            "static_obstacle_candidate_since_s": float(
+                self._last_debug.get("static_obstacle_candidate_since_s", 0.0) or 0.0
+            ),
+        })
+
+    def predict_trajectory(
+        self,
+        horizon_s: float = 3.0,
+        dt: float = 0.1,
+    ) -> np.ndarray:
+        raw_points = list(self._last_debug.get("mpc_trajectory_points", []) or [])
+        points = np.asarray(
+            [
+                [float(point[0]), float(point[1])]
+                for point in raw_points
+                if len(point) >= 2
+            ],
+            dtype=np.float64,
+        )
+        sample_count = max(1, int(round(float(horizon_s) / max(1.0e-3, float(dt)))))
+        if len(points) == 0:
+            location = self._actor.get_location()
+            return np.tile(
+                np.array([[float(location.x), float(location.y)]], dtype=np.float64),
+                (sample_count, 1),
+            )
+        if len(points) >= sample_count:
+            return points[:sample_count]
+        return np.vstack([points, np.tile(points[-1], (sample_count - len(points), 1))])
+
+    def done(self) -> bool:
+        try:
+            return bool(self._bridge.route_manager.last_status.reached_destination)
+        except Exception:
+            return False
+
+    @property
+    def target_speed_mps(self) -> float:
+        return float(self._target_speed_mps)
+
+    @property
+    def last_debug(self) -> Dict[str, object]:
+        return dict(self._last_debug)
+
+    @property
+    def corridor_half_width(self) -> float:
+        return 0.5 * float(self._bridge.config.get("lane_width_m", 3.5))
+
+    @property
+    def obstacle_lookahead_m(self) -> float:
+        return float(self._bridge.lookahead_m)
+
+    def destroy(self) -> None:
+        self._bridge.destroy()
+
+    def _traffic_light_views(self) -> List[_TrafficLightView]:
+        if self._traffic_lights is None:
+            actors = self._actor.get_world().get_actors()
+            try:
+                lights = list(actors.filter("traffic.traffic_light*"))
+            except Exception:
+                lights = [
+                    actor
+                    for actor in list(actors)
+                    if "traffic_light" in str(getattr(actor, "type_id", ""))
+                ]
+            self._traffic_lights = [_TrafficLightView(actor) for actor in lights]
+        return list(self._traffic_lights)
+
+    def _detection_snapshots(
+        self,
+        *,
+        transform: carla.Transform,
+        timestamp_s: float,
+    ) -> List[Dict[str, object]]:
+        yaw_rad = math.radians(float(transform.rotation.yaw))
+        cos_yaw = math.cos(yaw_rad)
+        sin_yaw = math.sin(yaw_rad)
+        detections_world: List[tuple[float, float, Detection]] = []
+        for detection in self._detections:
+            forward_m = float(detection.xy_ego[0])
+            right_m = float(detection.xy_ego[1])
+            world_x = (
+                float(transform.location.x)
+                + cos_yaw * forward_m
+                - sin_yaw * right_m
+            )
+            world_y = (
+                float(transform.location.y)
+                + sin_yaw * forward_m
+                + cos_yaw * right_m
+            )
+            detections_world.append((float(world_x), float(world_y), detection))
+
+        dt_s = (
+            0.05
+            if self._last_track_time_s is None
+            else max(1.0e-3, float(timestamp_s) - float(self._last_track_time_s))
+        )
+        previous = dict(self._tracks)
+        unmatched_ids = set(previous)
+        next_tracks: Dict[int, Dict[str, float]] = {}
+        snapshots: List[Dict[str, object]] = []
+        for world_x, world_y, detection in detections_world:
+            exact_actor_id = getattr(detection, "actor_id", None)
+            exact_world_xy = getattr(detection, "world_xy", None)
+            exact_velocity = getattr(detection, "velocity_world", None)
+            exact_acceleration = getattr(detection, "acceleration_world", None)
+            exact_angular_velocity = getattr(detection, "angular_velocity_world", None)
+            if exact_actor_id is not None and exact_world_xy is not None:
+                world_x = float(exact_world_xy[0])
+                world_y = float(exact_world_xy[1])
+                velocity_x = float(exact_velocity[0]) if exact_velocity is not None else 0.0
+                velocity_y = float(exact_velocity[1]) if exact_velocity is not None else 0.0
+                speed_mps = math.hypot(velocity_x, velocity_y)
+                heading_rad = (
+                    float(getattr(detection, "yaw", yaw_rad))
+                    if getattr(detection, "yaw", None) is not None
+                    else (math.atan2(velocity_y, velocity_x) if speed_mps > 0.05 else yaw_rad)
+                )
+                best_id = int(exact_actor_id)
+                unmatched_ids.discard(best_id)
+            else:
+                best_id = None
+                best_distance_m = 3.0
+                for track_id in list(unmatched_ids):
+                    track = previous[track_id]
+                    distance_m = math.hypot(
+                        float(world_x) - float(track["x"]),
+                        float(world_y) - float(track["y"]),
+                    )
+                    if distance_m < best_distance_m:
+                        best_id = int(track_id)
+                        best_distance_m = float(distance_m)
+                if best_id is None:
+                    best_id = int(self._next_track_id)
+                    self._next_track_id += 1
+                    speed_mps = 0.0
+                    heading_rad = float(yaw_rad)
+                else:
+                    unmatched_ids.discard(best_id)
+                    previous_track = previous[best_id]
+                    dx_m = float(world_x) - float(previous_track["x"])
+                    dy_m = float(world_y) - float(previous_track["y"])
+                    speed_mps = min(45.0, math.hypot(dx_m, dy_m) / float(dt_s))
+                    heading_rad = (
+                        math.atan2(dy_m, dx_m)
+                        if math.hypot(dx_m, dy_m) > 0.05
+                        else float(previous_track.get("psi", yaw_rad))
+                    )
+            next_tracks[best_id] = {
+                "x": float(world_x),
+                "y": float(world_y),
+                "v": float(speed_mps),
+                "psi": float(heading_rad),
+            }
+            radius_m = max(0.5, float(detection.radius))
+            peer_intent = {}
+            if self._cav_registry is not None and exact_actor_id is not None:
+                peer_intent = self._cav_registry.peer_messages(int(self._actor.id)).get(
+                    str(int(exact_actor_id)), {}
+                )
+            snapshots.append(
+                {
+                    "vehicle_id": f"carla_actor:{best_id}" if exact_actor_id is not None else f"mdrive_detection:{best_id}",
+                    "id": f"carla_actor:{best_id}" if exact_actor_id is not None else f"mdrive_detection:{best_id}",
+                    "carla_actor_id": int(exact_actor_id) if exact_actor_id is not None else None,
+                    "actor_type": str(getattr(detection, "actor_type", "")),
+                    "role_name": str(getattr(detection, "role_name", "")),
+                    "is_controlled_ego": bool(getattr(detection, "is_controlled_ego", False)),
+                    "x": float(world_x),
+                    "y": float(world_y),
+                    "v": float(speed_mps),
+                    "psi": float(heading_rad),
+                    "velocity_x_mps": float(exact_velocity[0]) if exact_velocity is not None else None,
+                    "velocity_y_mps": float(exact_velocity[1]) if exact_velocity is not None else None,
+                    "acceleration_x_mps2": float(exact_acceleration[0]) if exact_acceleration is not None else None,
+                    "acceleration_y_mps2": float(exact_acceleration[1]) if exact_acceleration is not None else None,
+                    "angular_velocity": (
+                        [float(value) for value in exact_angular_velocity]
+                        if exact_angular_velocity is not None else None
+                    ),
+                    "length_m": float(getattr(detection, "length_m", None) or max(2.0, 2.0 * radius_m)),
+                    "width_m": float(getattr(detection, "width_m", None) or max(1.0, 1.2 * radius_m)),
+                    "confidence": float(detection.score),
+                    "source": "mdrive_cooperative_perception",
+                    "provider_source": "perception_swap",
+                    "timestamp_s": float(timestamp_s),
+                    "cooperative_intent": dict(peer_intent),
+                }
+            )
+        self._tracks = next_tracks
+        self._last_track_time_s = float(timestamp_s)
+        return snapshots
diff --git a/simulation/leaderboard/team_code/test_cpx_multi_ego_data.py b/simulation/leaderboard/team_code/test_cpx_multi_ego_data.py
