+class _ActorLocalizer:
+    def __init__(self, actor: carla.Vehicle):
+        self.actor = actor
+
+    def get_ego_pos(self):
+        return self.actor.get_transform()
+
+    def get_ego_spd(self):
+        velocity = self.actor.get_velocity()
+        return 3.6 * math.sqrt(
+            float(velocity.x) ** 2
+            + float(velocity.y) ** 2
+            + float(velocity.z) ** 2
+        )
+
+
+class _TrafficLightView:
+    """Expose a real CARLA light with its trigger-volume stop location."""
+
+    def __init__(self, actor: Any):
+        self.actor = actor
+
+    def get_state(self):
+        return self.actor.get_state()
+
+    def get_location(self):
+        try:
+            trigger_location = carla.Location(
+                x=float(self.actor.trigger_volume.location.x),
+                y=float(self.actor.trigger_volume.location.y),
+                z=float(self.actor.trigger_volume.location.z),
+            )
+            return self.actor.get_transform().transform(trigger_location)
+        except Exception:
+            return self.actor.get_location()
+
