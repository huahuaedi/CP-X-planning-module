+# `import carla` below is what first resolves the process's libstdc++.so.6
+# to the conda env's own (older) copy -- confirmed via /proc/self/maps that
+# neither numpy nor anything above this line touches it. That's too late for
+# cpx_planner_adapter.py's own _preload_newer_libstdcxx() (called much later,
+# inside MDriveCPXPlanner construction) to matter: once a libstdc++.so.6 is
+# resident in the process under that SONAME, a later ctypes.CDLL call for
+# the same SONAME is a no-op -- it returns the already-loaded (older) one
+# rather than replacing it. convert_to_ros's AD-map global planner needs
+# GLIBCXX_3.4.29+; tcp_codriving_clean's own libstdc++ only goes to 3.4.28.
+# Preload the system's newer one here, before `import carla` gets a chance
+# to load the older one first -- confirmed via a controlled repro that doing
+# it in this order lets CPXMPCPlannerBridge's AD-map runtime
+# (ensure_runtime_ready) initialize cleanly, where the later-only preload
+# still failed with GLIBCXX_3.4.29 not found. Harmless no-op for every
+# non-CP-X planner: it's just a system library load, no CP-X repo
+# dependency.
+def _preload_newer_libstdcxx_before_carla_import() -> None:
+    import ctypes
+
+    for _candidate in (
+        "/usr/lib/x86_64-linux-gnu/libstdc++.so.6",
+        "libstdc++.so.6",
+    ):
+        try:
+            ctypes.CDLL(_candidate, mode=ctypes.RTLD_GLOBAL)
+            return
+        except OSError:
+            continue
+
+
+_preload_newer_libstdcxx_before_carla_import()
+
