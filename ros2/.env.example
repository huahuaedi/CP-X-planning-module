# Copy this file to .env and adapt paths only when your installation differs.
# .env is intentionally ignored by git.

ROS_DISTRO=jazzy
ROS_DOMAIN_ID=42
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
FASTDDS_BUILTIN_TRANSPORTS=UDPv4

# CPX_ROS_WS defaults to this ros2/ directory.
# CPX_PLANNER_ROOT defaults to the repository root (the parent of ros2/).
# Override either value only when the two source trees are installed apart.
# CPX_ROS_WS=/absolute/path/to/CP-X-planning-module/ros2
# CPX_PLANNER_ROOT=/absolute/path/to/CP-X-planning-module
CPX_PLANNER_DEPS=/root/cpx-python312-deps
CPX_PREDICTION_ROOT=/root/CP-X-Prediction
CPX_PREDICTION_ROS_WS=/root/CP-X-Prediction/ROS2-Code
MTR_VENV=/root/mtr-ros-py312

# Runtime behavior
CPX_PLANNER_SHARDS=2
CPX_PREDICTION_ENABLED=true
CPX_MTR_NUM_MODES=6
CPX_MTR_HISTORY_HZ=10.0
CPX_MTR_INFERENCE_HZ=5.0
# Reserve CPU scheduling capacity for the ROS Bridge and two Planner shards.
CPX_MTR_CPU_THREADS=4
CPX_PLANNER_CPU_THREADS=1
# Optional CPU isolation. Leave blank on unknown hardware. On the validated
# 24-core workstation, CARLA/OpenCDA used cores 0-15 while ROS used:
# CPX_MTR_CPUSET=16-19
# CPX_PLANNER_CPUSETS="20;21"
# CPX_BRIDGE_CPUSET=22
CPX_MTR_CPUSET=
CPX_PLANNER_CPUSETS=
CPX_BRIDGE_CPUSET=
CPX_PREDICTION_MAX_AGE_S=0.5
CPX_CONTROL_MAX_PLAN_AGE_S=0.5
CPX_DEBUG=false
CPX_DEBUG_TIME=true
